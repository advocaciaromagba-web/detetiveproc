# Copie para .env e ajuste. Nunca versione o .env.

# --- Painel (única porta publicada pelo docker compose) ---
PAINEL_PORT=3100

# --- PostgreSQL 16 ---
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
# Usada ao rodar a API/agendador fora do Docker; no compose ela é montada a partir
# das variáveis POSTGRES_* e aponta para o serviço "postgres".
DATABASE_URL=postgresql+asyncpg://monitor:troque-esta-senha@localhost:5432/monitor
# Banco descartável para testes de integração (o schema public é apagado a cada execução).
# TEST_DATABASE_URL=postgresql+asyncpg://monitor:troque-esta-senha@localhost:5432/monitor_teste

# --- Redis 7 (filas, cache e rate limiter compartilhado) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Armazenamento S3 do HTML/PDF bruto (SeaweedFS no compose) ---
S3_ACCESS_KEY=monitor
S3_SECRET_KEY=troque-esta-senha-s3
S3_PORT=8333
S3_BUCKET_BRUTO=bruto
# Usado ao rodar o agendador fora do Docker; no compose aponta para "seaweedfs".
S3_ENDPOINT=localhost:8333

# --- Coleta nos tribunais ---
# Contato técnico enviado no User-Agent do robô (e-mail ou página da equipe).
COLETOR_CONTATO=
# Páginas de resultado lidas por busca e validade do cache de cada consulta.
COLETOR_MAX_PAGINAS=20
COLETOR_CACHE_HORAS=24
# eproc/TJSP: só é ligado quando o leitor das páginas existir (depende da fase 0).
EPROC_TJSP_ATIVO=false

# --- OpenSearch 2.x (nó único, segurança desligada SOMENTE em desenvolvimento) ---
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_URL=http://localhost:9200

# --- Segurança ---
# Chave do HMAC usado por core.seguranca.hash_documento(). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
HASH_DOCUMENTO_CHAVE=

# --- E-mail (alertas) ---
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=true
SMTP_REMETENTE=Monitor Processual <alertas@exemplo.com.br>
# Avisos de operação (tribunal bloqueado por CAPTCHA ou mudança de layout)
EMAIL_OPERACAO=

# --- Logs e observabilidade (seção 9) ---
LOG_FORMATO=json
LOG_NIVEL=INFO
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USUARIO=admin
GRAFANA_SENHA=troque-esta-senha-grafana
